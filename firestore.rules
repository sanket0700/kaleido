rules_version = '2';

// Every write to Firestore in this app goes through a Next.js Route Handler
// using the Firebase Admin SDK (see src/lib/firebase/admin.ts), which
// bypasses these rules entirely. That's deliberate: post creation, likes,
// comments, and follow/unfollow all touch more than one document (a post
// plus the author's postCount, a like plus likeCount, a follow plus both
// users' follower/following counts) and need to happen inside a Firestore
// transaction to stay consistent - something client-side rules can't
// guarantee. This directly replaces the old backend's pattern of doing
// those fan-out writes as separate un-transactional .save() calls.
//
// So: everything below is read-only for the client SDK. If a future
// feature genuinely needs a direct client write (no cross-document
// consistency involved), add it explicitly and narrowly rather than
// loosening this default.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /usernames/{username} {
      // Reservation docs used by the signup/profile-edit Route Handlers to
      // enforce unique usernames via a transaction.
      allow read: if signedIn();
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow write: if false;

      match /likes/{userId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /follows/{relId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
